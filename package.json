{
  "name": "omnicopilot",
  "displayName": "OmniRoute for GitHub Copilot Chat",
  "description": "1200+ AI models in your Copilot Chat \u2014 free & forever free. Powered by OmniRoute: 340+ providers (90+ free) \u2014 Kimi, Claude, GPT, Gemini, GLM, DeepSeek, Qwen \u2014 with agent mode, tool calling, vision and auto-fallback. MIT open source.",
  "version": "1.1.0",
  "publisher": "diegosouzapw",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/diegosouzapw/OmniCopilot.git"
  },
  "bugs": {
    "url": "https://github.com/diegosouzapw/OmniCopilot/issues"
  },
  "homepage": "https://github.com/diegosouzapw/OmniRoute",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "language-models",
    "copilot",
    "github-copilot",
    "byok",
    "openai-compatible",
    "omniroute",
    "llm",
    "ai",
    "chat",
    "proxy",
    "router",
    "free-models",
    "claude",
    "gpt",
    "gemini",
    "deepseek",
    "kimi",
    "glm",
    "qwen",
    "ollama",
    "agent-mode",
    "tool-calling"
  ],
  "badges": [
    {
      "url": "https://img.shields.io/github/stars/diegosouzapw/OmniRoute?style=social",
      "description": "Star OmniRoute on GitHub",
      "href": "https://github.com/diegosouzapw/OmniRoute"
    }
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnicopilot",
          "title": "OmniRoute",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "omnicopilot": [
        {
          "type": "webview",
          "id": "omnicopilot.panel",
          "name": "%view.connection%",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "omniroute",
        "displayName": "OmniRoute",
        "managementCommand": "omnicopilot.manage"
      }
    ],
    "commands": [
      {
        "command": "omnicopilot.manage",
        "category": "OmniRoute",
        "title": "%cmd.manage%"
      },
      {
        "command": "omnicopilot.setApiKey",
        "category": "OmniRoute",
        "title": "%cmd.setApiKey%"
      },
      {
        "command": "omnicopilot.refreshModels",
        "category": "OmniRoute",
        "title": "%cmd.refreshModels%"
      },
      {
        "command": "omnicopilot.checkConnection",
        "category": "OmniRoute",
        "title": "%cmd.checkConnection%"
      },
      {
        "command": "omnicopilot.openDashboard",
        "category": "OmniRoute",
        "title": "%cmd.openDashboard%"
      },
      {
        "command": "omnicopilot.openGitHub",
        "category": "OmniRoute",
        "title": "%cmd.openGitHub%"
      },
      {
        "command": "omnicopilot.installOmniRoute",
        "category": "OmniRoute",
        "title": "%cmd.installOmniRoute%"
      },
      {
        "command": "omnicopilot.configureCliTool",
        "category": "OmniRoute",
        "title": "%cmd.configureCliTool%"
      },
      {
        "command": "omnicopilot.quickActions",
        "category": "OmniRoute",
        "title": "%cmd.quickActions%"
      },
      {
        "command": "omnicopilot.openSettings",
        "category": "OmniRoute",
        "title": "%cmd.openSettings%"
      }
    ],
    "configuration": {
      "title": "OmniRoute for Copilot",
      "properties": {
        "omnicopilot.baseUrl": {
          "type": "string",
          "default": "http://localhost:20128",
          "order": 1,
          "description": "%cfg.baseUrl%"
        },
        "omnicopilot.statusBar": {
          "type": "boolean",
          "default": true,
          "order": 2,
          "description": "%cfg.statusBar%"
        },
        "omnicopilot.healthCheckIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "maximum": 3600,
          "order": 3,
          "description": "%cfg.healthCheckIntervalSeconds%"
        },
        "omnicopilot.maxOutputTokens": {
          "type": "number",
          "default": 16384,
          "minimum": 256,
          "order": 4,
          "description": "%cfg.maxOutputTokens%"
        },
        "omnicopilot.defaultContextLength": {
          "type": "number",
          "default": 128000,
          "minimum": 1024,
          "order": 5,
          "description": "%cfg.defaultContextLength%"
        },
        "omnicopilot.modelFilter": {
          "type": "string",
          "default": "",
          "order": 6,
          "description": "%cfg.modelFilter%"
        },
        "omnicopilot.dashboardOpen": {
          "type": "string",
          "enum": [
            "external",
            "editor"
          ],
          "enumDescriptions": [
            "%cfg.dashboardOpen.external%",
            "%cfg.dashboardOpen.editor%"
          ],
          "default": "external",
          "order": 7,
          "description": "%cfg.dashboardOpen%"
        },
        "omnicopilot.defaultReasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "none",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "enumDescriptions": [
            "%cfg.defaultReasoningEffort.unset%",
            "%cfg.defaultReasoningEffort.none%",
            "%cfg.defaultReasoningEffort.low%",
            "%cfg.defaultReasoningEffort.medium%",
            "%cfg.defaultReasoningEffort.high%",
            "%cfg.defaultReasoningEffort.xhigh%"
          ],
          "default": "",
          "order": 8,
          "description": "%cfg.defaultReasoningEffort%"
        },
        "omnicopilot.cliPath": {
          "type": "string",
          "default": "omniroute",
          "order": 9,
          "description": "%cfg.cliPath%"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run check-types && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "icon": "node scripts/render-icon.mjs",
    "package": "npm run check-types && node esbuild.mjs --production",
    "vscode:prepublish": "npm run package",
    "vsix": "vsce package -o omnicopilot.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "sharp": "^0.35.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.0.0"
  }
}
